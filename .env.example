# Copy to .env on the machine that hosts ARTESH. Never commit .env.

# Your OpenAI API key. Stays on this machine; the browser never sees it.
OPENAI_API_KEY=

# The password you type once per device to open the app.
ARTESH_PASSWORD=

# Optional
# PORT=8080
# HOST=127.0.0.1              # bind to localhost only when a tunnel or reverse proxy sits in front
# OPENAI_MODEL=gpt-6-luna
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# ARTESH_DATA_DIR=./private   # where the campaign and sessions are stored
