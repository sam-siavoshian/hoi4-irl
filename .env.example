# Copy to .env on the machine that hosts Home Front. Never commit .env.
# Real environment variables win over this file.

# ---- required ----
# The password you type once per device to open the app.
HOMEFRONT_PASSWORD=

# ---- the judge ----
# The easy way is in the app: Settings → General staff. Choose a provider (OpenAI, Anthropic, Google Gemini, Groq,
# Mistral, OpenRouter, Ollama, LM Studio, another server, or the offline judge), paste your own key and press Test.
# The key is kept in ai.json in the data folder (owner-only) and never sent back to the browser.
# What is set in the app wins. Everything below is the fallback, for an install that prefers its keys in this file:
# a key set here shows in the app as "set on the server" and cannot be read or removed from the app.

# API key. Stays on this machine; the browser never sees it. Leave empty for a local server that needs none.
OPENAI_API_KEY=
# Where the provider lives. Default: https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# Which API to speak: "responses" (OpenAI Responses API, the default) or "chat" (Chat Completions: Ollama, LM Studio, OpenRouter, Groq, ...).
# LLM_API=responses
# The model that judges reports. A small one is enough.
# OPENAI_MODEL=gpt-6-luna
# How long to wait for the provider before giving up, in milliseconds (slow local models may need more).
# LLM_TIMEOUT_MS=180000
# With neither a key nor OPENAI_BASE_URL, and nothing chosen in the app, the offline keyword judge is used.

# A key for another provider, kept here instead of in the app. Choose the provider in Settings.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# Another address for a provider (a gateway or a proxy). Each defaults to the provider's own.
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- voice transcription ----
# The transcription model, or "off" to disable server-side transcription (the keyboard's dictation key still works).
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Endpoint for transcription (POST <base>/audio/transcriptions). Default: OPENAI_BASE_URL.
# OPENAI_TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# Key for the transcription endpoint. Default: OPENAI_API_KEY.
# OPENAI_TRANSCRIBE_API_KEY=

# ---- automation (iOS Shortcuts, Siri, scripts, the `homefront` command) ----
# A long random token (16+ characters, e.g. `openssl rand -hex 24`). Requests carrying "Authorization: Bearer <token>"
# may use POST /api/report, GET /api/sitrep and GET /api/journal, and nothing else. Leave empty to turn this off.
# HOMEFRONT_TOKEN=

# ---- server ----
# Port to listen on.
# PORT=8080
# Address to bind. Use 127.0.0.1 when a tunnel or reverse proxy sits in front.
# HOST=127.0.0.1
# Tailnet HTTPS port that deploy/install-macos.sh and the watchdog serve the app on (tailscale serve).
# HOMEFRONT_HTTPS_PORT=8443
# Where the campaign, journal, backups, sessions and the provider settings (ai.json, with your keys) are stored.
# The default is ~/.homefront. Keep it outside the source folder.
# HOMEFRONT_DATA_DIR=~/.homefront
# Requests per minute per address allowed on /api/llm, /api/transcribe, /api/report and /api/ai/test (0 = no limit).
# HOMEFRONT_RATE_LIMIT=60
# Set to 1 to run with no login at all. Only on a machine nobody else can reach.
# HOMEFRONT_OPEN=1

# ---- example: Ollama on this machine (no key) ----
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_API=chat
# OPENAI_MODEL=llama3.2
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=off
# LLM_TIMEOUT_MS=180000

# ---- example: OpenRouter ----
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_API=chat
# OPENAI_API_KEY=sk-or-...
# OPENAI_MODEL=openai/gpt-6-luna
# OPENAI_TRANSCRIBE_MODEL=off
