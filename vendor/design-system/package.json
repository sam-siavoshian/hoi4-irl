{
  "name": "@sam/design-system",
  "version": "2.0.0",
  "description": "The Lanes design system, 1:1: tokens, motion, the component kit, optional backdrops and patterns. React 19 + Tailwind 4.",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/fonts.ts"
  ],
  "exports": {
    ".": "./src/components/ui/index.ts",
    "./styles.css": "./src/design/index.css",
    "./fonts": "./src/fonts.ts",
    "./motion": "./src/motion/index.ts",
    "./backdrops": "./src/backdrops/index.ts",
    "./patterns": "./src/patterns/index.ts",
    "./theme": "./src/design/theme.ts",
    "./keybindings": "./src/lib/keybindings/index.ts",
    "./utils": "./src/lib/utils.ts",
    "./theme-boot.js": "./boot/theme-boot.js",
    "./check": "./check/kit-check.mjs",
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "sam-design-check": "./check/kit-check.mjs"
  },
  "files": [
    "src",
    "boot",
    "check",
    "dist",
    "COMPONENTS.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=4.3.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "class-variance-authority": "0.7.1",
    "lucide": "1.66.0",
    "lucide-react": "1.66.0",
    "morphicons": "1.7.1",
    "tailwind-merge": "3.7.0"
  }
}
