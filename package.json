{
  "name": "homefront",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Home Front: a productivity app and daily journal that shows your life as a 1936 grand-strategy war map. Say what happened today; it files the entry and the front lines move, so you see every part of your life at a glance. Self-hosted, works with any AI provider or offline.",
  "license": "MIT",
  "homepage": "https://homefront-map.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sam-siavoshian/homefront-map.git"
  },
  "bugs": {
    "url": "https://github.com/sam-siavoshian/homefront-map/issues"
  },
  "keywords": [
    "productivity",
    "productivity-app",
    "habit-tracker",
    "life-tracker",
    "daily-journal",
    "journal",
    "journaling",
    "diary",
    "personal-tracker",
    "goal-tracker",
    "gamification",
    "gamified-productivity",
    "quantified-self",
    "personal-dashboard",
    "self-hosted",
    "local-first",
    "privacy",
    "open-source",
    "pwa",
    "offline-first",
    "voice-journal",
    "speech-to-text",
    "ai",
    "llm",
    "ai-journal",
    "openai",
    "anthropic",
    "gemini",
    "ollama",
    "local-llm",
    "grand-strategy",
    "strategy-game",
    "war-map",
    "alternate-history",
    "1936",
    "hoi4",
    "map",
    "canvas",
    "react",
    "nodejs"
  ],
  "bin": {
    "homefront": "bin/homefront.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prestart": "node tools/ensure-build.mjs",
    "start": "node server.mjs",
    "preserve": "node tools/ensure-build.mjs",
    "serve": "node tools/serve.mjs",
    "check:design": "sam-design-check src site",
    "dev:site": "vite --config vite.site.config.js",
    "build:map": "node tools/build-map.mjs",
    "build:site": "node tools/build-site.mjs",
    "pretest": "node tools/ensure-build.mjs",
    "test": "node --test tests/engine.test.mjs tests/classify.test.mjs tests/voice.test.mjs tests/server.test.mjs tests/ask.test.mjs tests/scenario.test.mjs tests/countries.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "docker": "docker build -t homefront .",
    "test:all": "npm test && sam-design-check src site && node tests/e2e.mjs && node tests/fx.e2e.mjs && node tests/share.e2e.mjs"
  },
  "devDependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.155",
    "@sam/design-system": "file:vendor/design-system",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.2.1",
    "d3-delaunay": "^6.0.4",
    "lucide-react": "1.66.0",
    "polygon-clipping": "^0.15.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "^16.38.0",
    "tailwindcss": "4.3.3",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "vite": "8.3.5",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Home Front contributors"
}
