{
  "name": "artesh",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ARTESH: a self-hosted life tracker drawn as a 1936 grand-strategy war map. Report your day, an LLM general staff judges it, and the fronts move.",
  "license": "MIT",
  "homepage": "https://sam-siavoshian.github.io/hoi4-irl/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sam-siavoshian/hoi4-irl.git"
  },
  "bugs": {
    "url": "https://github.com/sam-siavoshian/hoi4-irl/issues"
  },
  "keywords": [
    "productivity",
    "habit-tracker",
    "life-tracker",
    "journal",
    "gamification",
    "grand-strategy",
    "self-hosted",
    "pwa",
    "llm",
    "openai",
    "ollama",
    "canvas",
    "no-build"
  ],
  "bin": {
    "artesh": "bin/artesh.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "serve": "node tools/serve.mjs",
    "build:map": "node tools/build-map.mjs",
    "test": "node --test tests/engine.test.mjs tests/classify.test.mjs tests/server.test.mjs tests/ask.test.mjs tests/scenario.test.mjs tests/countries.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "docker": "docker build -t artesh .",
    "test:all": "npm test && node --test tests/ask.test.mjs && node tests/e2e.mjs && node tests/fx.e2e.mjs && node tests/share.e2e.mjs"
  },
  "devDependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.155",
    "d3-delaunay": "^6.0.4",
    "polygon-clipping": "^0.15.7",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
